# AT HOP Account Credentials
AT_USERNAME=your.email@example.com
AT_PASSWORD=your_password_here

# AT HOP Card Numbers (comma-separated, optionally with names)
# Format: card_number:name,card_number:name
AT_CARDS=7824670200012345678:YourName,7824670200087654321:FamilyMember

# Scraping Configuration
AT_PERIOD=3600
AT_STARTUP_DELAY=60

# Slack Configuration (optional)
AT_SLACK_API_TOKEN=xoxb-your-slack-token-here
AT_SLACK_CHANNEL=#notifications

# GTFS stop data for map links (optional; set refresh days to 0 to disable)
# AT_GTFS_URL=https://gtfs.at.govt.nz/gtfs.zip
# AT_GTFS_REFRESH_DAYS=7
# AT_GTFS_DATABASE_FILE=/data/gtfs.db

# Mapbox public token (pk.*) for static journey map images in Slack (optional)
# AT_MAPBOX_TOKEN=pk.your-token-here
# AT_MAPBOX_STYLE=mapbox/streets-v12
